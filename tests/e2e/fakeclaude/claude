#!/usr/bin/env python3
"""시험용 claude 대역 — 미리 적어 둔 답만 돌려준다 (실제 AI 아님). 프로그램 흐름(요청 · 재요청 · 기록) 시험 전용."""
import json, os, sys
here = os.path.dirname(os.path.abspath(__file__))
log = os.path.join(here, "calls.jsonl")
args = sys.argv[1:]
if args[:1] == ["--version"]:
    print("9.9.9 (Claude Code 시험용 대역)"); sys.exit(0)
if args[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": True, "authMethod": "claude.ai"})); sys.exit(0)
prompt = sys.stdin.read()
n = (sum(1 for _ in open(log, encoding="utf-8")) if os.path.exists(log) else 0) + 1
with open(log, "a", encoding="utf-8") as f:
    f.write(json.dumps({"n": n, "argv": args, "cwd": os.getcwd(), "cwd_files": os.listdir(os.getcwd()),
                        "env_keys": sorted(k for k in os.environ if k.startswith(("ANTHROPIC_", "AWS_"))), "prompt": prompt}, ensure_ascii=False) + "\n")
answers = json.load(open(os.path.join(here, "answers.json"), encoding="utf-8"))
# 연결한 프로젝트(주문 API 예제) 요청이면 그 예제용 답 (요청 글에 운영 서버 보안 그룹이 보일 때)
alt = os.path.join(here, "answers_orders.json")
MARK = 'resource "aws_security_group" "ops"'
if os.path.exists(alt) and MARK in prompt:
    answers = json.load(open(alt, encoding="utf-8"))
    n = sum(1 for line in open(log, encoding="utf-8") if MARK.replace('"', '\\"') in line)   # 이 예제 요청만 센다 (이번 것 포함)
# 시나리오 모드 (mode.txt, E2E 가 씀): bad = 매번 다른 '막히는' 수정안(최대 시도까지 미통과 → GAVE_UP) · repeat = 똑같은 막히는 수정안(→ REPEATED)
# · error = AI 오류 · unknown = 출처를 확정할 수 없는 수정안(외부 prefix list → 검증 불가). 없으면 기본 답.
mode_f = os.path.join(here, "mode.txt")
mode = open(mode_f, encoding="utf-8").read().strip() if os.path.exists(mode_f) else ""
if mode == "bad":
    body = answers[0].replace("```hcl", "```hcl\n# 시도 %d (시험용 — 매번 다른 파일)" % n, 1)
elif mode == "repeat":
    body = answers[0]
elif mode == "error":
    body = "__ERROR__"
elif mode == "unknown":
    body = open(os.path.join(here, "answer_unknown.txt"), encoding="utf-8").read()
else:
    body = answers[min(n, len(answers)) - 1]
if body == "__ERROR__":
    print(json.dumps({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "시험용 오류", "session_id": f"fake-{n}"})); sys.exit(1)
print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": body, "session_id": f"fake-{n}",
                  "total_cost_usd": 0, "modelUsage": {"fake-model": {}}}, ensure_ascii=False))
