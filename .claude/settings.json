      "Bash(terraform show:*)",
      "Bash(tofu fmt:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu plan:*)",
      "Bash(tofu show:*)",
      "Bash(trivy config:*)",
      "Bash(trivy --version:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python -m unittest:*)",
      "Bash(python3 scripts/*)",
      "Bash(python scripts/*)",
      "Bash(bash scripts/run_experiments.sh:*)",
      "Bash(bash scripts/run_tests.sh:*)"
