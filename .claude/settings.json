      "Bash(printenv:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/**)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/terraform.tfvars)",
      "Edit(./policy/**)",
      "Edit(./tests/fixtures/**)",
      "Edit(./experiments/**/results-history/**)",
      "Edit(./.github/**)",
      "Write(./policy/**)",
      "Write(./tests/fixtures/**)",
      "Write(./.github/**)"
