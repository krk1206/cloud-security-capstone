# 실제 apply 용 변수 파일 예시. 이 파일을 terraform.tfvars 로 복사해서 값을 채운다.
# terraform.tfvars 는 .gitignore 에 있어 git 에 올라가지 않는다. 자격증명(액세스 키)은 여기에도 적지 않는다 — 환경변수로만.

# 1) 콘솔 EC2 → 인스턴스 시작 → "Amazon Linux 2023" 아래 표시되는 AMI ID 를 복사해서 넣는다 (서울 리전 기준).
ami_id = "ami-0123456789abcdef0"

# 2) S3 버킷 이름은 전 세계 유일. 겹치면(BucketAlreadyExists) 뒤에 날짜·이니셜을 붙여 바꾼다.
bucket_name = "iacpatch-webapp-assets-demo"

# 3) 나머지는 기본값(variables.tf)을 쓴다. 바꾸고 싶으면 여기에 적는다.
# aws_region    = "ap-northeast-2"
# instance_type = "t2.micro"   # 서울 프리 티어 대상. 바꾸지 말 것(돈 안 쓰는 조건)
